{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue"
    ],
    "exclude": [
        "src/**/__tests__/*"
    ],
    "compilerOptions": {
        "composite": true,
        "lib": [
            "ES2021",
            "DOM",
            "DOM.Iterable"
        ],
        "sourceMap": true,
        "noImplicitAny": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    }
}
